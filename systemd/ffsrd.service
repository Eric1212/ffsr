[Unit]
Description=ffsrd — FireFox Simple Relay daemon (WS bridge to 9222)
Documentation=man:ffsr(1)

[Service]
Type=simple
ExecStart=/usr/local/bin/ffsrd
Environment=FFSRD_TARGET_UID=1000
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# Répertoires gérés par systemd (créés au start, purgés au stop)
# RuntimeDirectoryMode=0755 : CRITIQUE — eric (le CLI, uid 1000) doit
# pouvoir pénétrer /run/ffsrd pour atteindre le socket chowné.
RuntimeDirectory=ffsrd
RuntimeDirectoryMode=0755
StateDirectory=ffsrd

# Hardening (calqué sur ram-reclaim.service de la machine de référence)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target