[Unit]
Description=ffsrd — FireFox Simple Relay daemon (WS bridge to 9222)
Documentation=man:ffsr(1)

[Service]
Type=simple
ExecStart=/usr/local/bin/ffsrd
Environment=FFSRD_TARGET_UID=1000
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# Directories managed by systemd (created at start, purged at stop)
# RuntimeDirectoryMode=0755: CRITICAL — eric (the CLI, uid 1000) must
# be able to enter /run/ffsrd to reach the chowned socket.
RuntimeDirectory=ffsrd
RuntimeDirectoryMode=0755
StateDirectory=ffsrd

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
